{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="publication-search">
    <label class="eyebrow publication-search-label" for="bibsearch"><span aria-hidden="true">[/]</span> Find a paper</label>
    <input
      type="search"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="Search titles, authors, or topics…"
    >
  </div>
{% endif %}
